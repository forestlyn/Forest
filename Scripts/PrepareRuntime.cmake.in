cmake_minimum_required(VERSION 3.21)
if(NOT DESTINATION OR NOT CONFIG)
    message(FATAL_ERROR "Runtime staging requires a destination and configuration")
endif()
set(source "@CMAKE_SOURCE_DIR@")
file(MAKE_DIRECTORY "${DESTINATION}")
if(NOT DEPENDENCIES_ONLY)
    foreach(category shaders textures fonts scenes)
        file(COPY "${source}/EngineEditor/resources/assets/${category}"
            DESTINATION "${DESTINATION}/resources/assets")
    endforeach()
    if(EDITOR)
        file(COPY "${source}/EngineEditor/resources/template" DESTINATION "${DESTINATION}/resources")
    endif()
    file(COPY "${source}/Engine/ThirdParty/mono/4.5" DESTINATION "${DESTINATION}/Mono")
    file(COPY "${source}/Engine/ThirdParty/mono/LICENSE" DESTINATION "${DESTINATION}/Mono")
    file(MAKE_DIRECTORY "${DESTINATION}/Managed")
    file(COPY_FILE "${CORE_ASSEMBLY}" "${DESTINATION}/Managed/Engine-ScriptCore.dll" ONLY_IF_DIFFERENT)
    file(GLOB mono_native "${source}/Engine/ThirdParty/mono/bin/${CONFIG}/*.dll")
    file(COPY ${mono_native} DESTINATION "${DESTINATION}")
    set(system_runtime_files "@CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS@")
    foreach(runtime IN LISTS system_runtime_files)
        string(TOLOWER "${runtime}" runtime_lower)
        if(NOT CONFIG STREQUAL "Debug" AND
           (runtime_lower MATCHES "debug_nonredist" OR runtime_lower MATCHES "ucrtbased\\.dll$"))
            # Remove only known staged CRT files left by older staging rules.
            get_filename_component(runtime_name "${runtime}" NAME)
            file(REMOVE "${DESTINATION}/${runtime_name}")
            continue()
        endif()
        if(EXISTS "${runtime}")
            file(COPY "${runtime}" DESTINATION "${DESTINATION}")
        endif()
    endforeach()
else()
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL dumpbin)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@FOREST_MSVC_TOOL_DIRECTORY@/dumpbin.exe")
    file(GET_RUNTIME_DEPENDENCIES
        EXECUTABLES "${EXECUTABLE}"
        LIBRARIES "${DESTINATION}/mono-2.0-sgen.dll" "${DESTINATION}/MonoPosixHelper.dll"
        DIRECTORIES "${DESTINATION}" "$ENV{VULKAN_SDK}/Bin"
        RESOLVED_DEPENDENCIES_VAR dependencies
        UNRESOLVED_DEPENDENCIES_VAR unresolved
        PRE_EXCLUDE_REGEXES "^[Aa][Pp][Ii]-[Mm][Ss]-" "^[Ee][Xx][Tt]-[Mm][Ss]-"
        POST_EXCLUDE_REGEXES [[.*[Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\][Ss][Yy][Ss][Tt][Ee][Mm]32[/\\].*]])
    if(unresolved)
        message(FATAL_ERROR "Unresolved runtime dependencies: ${unresolved}")
    endif()
    foreach(dependency IN LISTS dependencies)
        get_filename_component(dependency_name "${dependency}" NAME)
        string(TOLOWER "${dependency_name}" dependency_name)
        if(NOT CONFIG STREQUAL "Debug" AND
           dependency_name MATCHES "^(msvcp[0-9_]+d.*|vcruntime[0-9_]+d|concrt[0-9]+d|ucrtbased|shaderc_sharedd)\\.dll$")
            message(FATAL_ERROR "Debug DLL in ${CONFIG} dependencies: ${dependency}")
        endif()
        get_filename_component(directory "${dependency}" DIRECTORY)
        if(NOT directory STREQUAL DESTINATION)
            file(COPY "${dependency}" DESTINATION "${DESTINATION}")
        endif()
    endforeach()
    file(WRITE "${DESTINATION}/runtime-dependencies.txt" "${dependencies}\n")
    file(WRITE "${DESTINATION}/runtime-build.yaml" "Configuration: ${CONFIG}\n")
endif()
